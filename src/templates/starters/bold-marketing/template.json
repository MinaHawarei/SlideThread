{
  "schema": 1,
  "id": "bold-marketing",
  "name": { "en": "Bold Marketing", "ar": "تسويق جريء" },
  "description": { "en": "High-contrast layouts for launches and campaigns.", "ar": "تخطيطات عالية التباين للإطلاقات والحملات." },
  "author": { "name": "SlideThread" },
  "license": "MIT",
  "categories": ["marketing"],
  "tags": ["campaign", "high-contrast", "statement"],
  "colorFlexible": true,
  "theme": {
    "modes": {
      "dark": { "bg": "#15161B", "bg2": "#24252C", "ink": "#FFF8E9", "mute": "#C5C1B9", "card": "#25262C", "line": "#64636A" },
      "light": { "bg": "#FFF8E9", "bg2": "#F0E7D5", "ink": "#17171A", "mute": "#605B52", "card": "#FFFFFF", "line": "#29282B" }
    },
    "fonts": { "display": "ibm-plex-sans", "body": "ibm-plex-sans-arabic", "mono": "jetbrains-mono" },
    "typeScale": { "h1": 124, "h2": 80, "body": 44, "small": 30, "mono": 34 },
    "radius": { "card": 0, "chip": 0 }
  },
  "layouts": { "cover": "cover-editorial", "explain": "explain-centered", "rule": "rule-centered", "compare": "compare-editorial", "code": "code-editorial", "stat": "stat-centered", "quote": "quote-editorial", "image": "image-centered", "cta": "cta-editorial" },
  "formats": "all",
  "counter": { "styles": ["number", "bar"], "defaultStyle": "number" },
  "assets": {
    "badge": "pack:stickers/sticker-new-badge",
    "cornerAccent": "assets/flourish-corner.svg"
  }
}
