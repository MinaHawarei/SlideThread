{
  "schema": 1,
  "id": "clean-minimal",
  "name": { "en": "Clean Minimal", "ar": "بسيط ونظيف" },
  "description": { "en": "Quiet space for personal ideas.", "ar": "مساحة هادئة للأفكار الشخصية." },
  "author": { "name": "SlideThread" },
  "license": "MIT",
  "categories": ["personal-brand", "general"],
  "tags": ["minimal", "editorial", "whitespace"],
  "colorFlexible": true,
  "counter": { "styles": ["bar"], "defaultStyle": "bar" },
  "theme": {
    "fonts": { "display": "ibm-plex-sans", "body": "ibm-plex-sans-arabic", "mono": "jetbrains-mono" },
