    "radius": { "card": 12, "chip": 6 }
  },
  "layouts": { "cover": "cover-centered", "explain": "explain-editorial", "rule": "rule-editorial", "compare": "compare-centered", "code": "code-centered", "stat": "stat-editorial", "quote": "quote-editorial", "image": "image-centered", "cta": "cta-centered" },
  "formats": ["post", "carousel"]
